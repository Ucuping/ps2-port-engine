{
  "version": 3,
  "configurePresets": [
    {
      "name": "macos-arm64",
      "displayName": "macOS on Apple silicon",
      "description": "Apple clang and Ninja against the default macOS SDK, by name (xcrun resolves it), deployment target 26.0. The SDK and the linker must be a pair: an SDK whose libraries the installed ld cannot read fails every link.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/port/cmake-macos-arm64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_SYSROOT": "macosx",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    }
  ]
}
